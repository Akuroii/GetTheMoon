# Postgres connection string (Neon or Vercel Postgres)
DATABASE_URL=

# YouTube Data API v3 key — server-side only, never exposed to the browser.
# Read only by lib/youtube.ts, which is only ever imported from server code.
YOUTUBE_API_KEY=

# The channel this site tracks
YOUTUBE_CHANNEL_ID=

# Shared secret the external cron-ping service must send as
# `Authorization: Bearer <value>` when calling POST /api/ingest
INGEST_SECRET=
